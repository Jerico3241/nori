{
  "name": "nori",
  "contractVersion": 3,
  "note": "Kanonischer plattformübergreifender Contract. App-Versionen stammen ausschließlich aus den jeweiligen Xcode-Projekten.",
  "providers": {
    "aniworld": {
      "origin": "https://aniworld.to",
      "kind": "Anime",
      "paths": {
        "catalog": "/animes",
        "calendar": "/animekalender",
        "series": "/anime/stream/{slug}",
        "season": "/anime/stream/{slug}/staffel-{id}",
        "films": "/anime/stream/{slug}/filme",
        "episode": "/anime/stream/{slug}/staffel-{season}/episode-{n}",
        "film": "/anime/stream/{slug}/filme/film-{n}",
        "redirect": "/redirect/{id}"
      }
    },
    "serienstream": {
      "origin": "https://serienstream.to",
      "kind": "Serien",
      "paths": {
        "catalog": "/serien?by=genre",
        "calendar": "/api/calendar",
        "series": "/serie/{slug}",
        "season": "/serie/{slug}/staffel-{id}",
        "films": "/serie/{slug}/filme",
        "episode": "/serie/{slug}/staffel-{season}/episode-{n}",
        "film": "/serie/{slug}/filme/film-{n}",
        "redirect": "/r?t={token}"
      }
    }
  },
  "models": {
    "CatalogItem": ["slug", "title", "alts", "genres", "provider"],
    "SeasonRef": ["id", "label"],
    "Episode": ["number", "germanTitle", "englishTitle", "path", "hosters", "languages"],
    "SeriesDetail": ["slug", "title", "alts", "description", "coverPath", "yearStart", "yearEnd", "fsk", "imdb", "genres", "seasons", "activeSeason", "episodes"],
    "HosterOption": ["name", "lang", "langKey", "redirectPath"],
    "WatchInfo": ["path", "title", "germanTitle", "englishTitle", "hosters"],
    "PlaySource": ["kind", "url", "hoster", "lang", "referer"],
    "WatchProgress": ["slug", "title", "season", "episode", "episodePath", "germanTitle", "englishTitle", "positionSec", "durationSec", "updatedAt", "lang", "completed", "provider"],
    "RecentItem": ["slug", "title", "viewedAt", "provider"],
    "AiringEntry": ["airingAt", "episode", "season", "title", "english", "slug", "languages", "dayKey", "dayLabel", "coverPath", "provider"],
    "CalendarPayload": ["upcoming", "recent", "fetchedAt"]
  },
  "library": {
    "schemaVersion": 4,
    "progressIdentity": "provider + normalized episodePath",
    "scope": "all|aniworld|serienstream|kdrama",
    "fields": ["favorites", "recents", "titles", "progress", "langPref", "hosterPref", "resumeEnabled", "autoplayNext", "playbackSpeed", "provider", "scope", "favoriteSource", "modifiedAt"],
    "migration": "Ältere Datensätze werden beim Laden normalisiert; Provider und Pfade werden ergänzt und doppelte Fortschrittseinträge anhand updatedAt zusammengeführt."
  },
  "sync": {
    "providerInterface": ["name", "load", "save"],
    "behavior": "Ein neuerer Fremdstand gewinnt beim manuellen Abgleich und wird anschließend lokal sowie beim Anbieter gespeichert."
  },
  "rules": {
    "complete": "completed == true OR (durationSec >= 20 AND positionSec >= durationSec * 0.9)",
    "resume": "if complete then 0; if positionSec < 8 then 0; else positionSec",
    "autoplay": "when enabled and a following episode exists, show an 8 second countdown and start the next episode",
    "playbackSpeeds": [0.75, 1.0, 1.25, 1.5, 2.0],
    "langOrder": ["DE", "GerSub", "EN"],
    "hosterOrder": ["voe", "vidmoly", "vidoza", "lulustream", "speedfiles", "filemoon", "doodstream"],
    "nativePlay": "AVPlayer plays the resolved HTTPS media URL directly with the source referer when required.",
    "provider": "CatalogProvider is persisted explicitly on new catalog, calendar, recent and progress records where applicable."
  }
}
