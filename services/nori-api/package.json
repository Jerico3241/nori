{
  "name": "@nori/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nori-Provider-Schicht als HTTP-Dienst für Clients, die nicht selbst scrapen können (webOS)",
  "scripts": {
    "prebuild": "npm --prefix ../../shared/nori-core run build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nori/core": "file:../../shared/nori-core",
    "linkedom": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  }
}
