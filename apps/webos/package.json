{
  "name": "@nori/webos",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "Nori für LG webOS — TV-Oberfläche mit Fernbedienungsnavigation",
  "scripts": {
    "prebuild": "npm --prefix ../../shared/nori-core run build",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mock": "node test/mock-server.mjs",
    "test:tv": "node test/remote-control.test.mjs",
    "webos:package": "node tools/package-ipk.mjs",
    "webos:install": "node tools/webos-cli.mjs install",
    "webos:launch": "node tools/webos-cli.mjs launch",
    "webos:inspect": "node tools/webos-cli.mjs inspect",
    "webos:devices": "node tools/webos-cli.mjs devices"
  },
  "dependencies": {
    "@nori/core": "file:../../shared/nori-core",
    "hls.js": "^1.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
