{
  "name": "@nori/windows",
  "productName": "Nori",
  "version": "2.1.0",
  "private": true,
  "description": "Nori für Windows — Anime und Serien auf dem Schreibtisch",
  "author": "Nori",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jerico3241/nori.git"
  },
  "main": "dist-main/main.cjs",
  "type": "module",
  "scripts": {
    "prebuild": "npm --prefix ../../shared/nori-core run build",
    "build:main": "node tools/build-main.mjs",
    "build:renderer": "vite build",
    "build": "tsc --noEmit && npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --win --x64 --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:linux": "npm run build && electron-builder --linux dir --publish never",
    "test:desktop": "node test/desktop.test.mjs"
  },
  "dependencies": {
    "@nori/app": "file:../../shared/nori-app",
    "@nori/core": "file:../../shared/nori-core",
    "hls.js": "^1.7.2",
    "linkedom": "^0.18.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
