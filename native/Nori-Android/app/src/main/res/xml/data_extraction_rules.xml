<?xml version="1.0" encoding="utf-8"?>
<!-- Siehe backup_rules.xml: `file` ist `filesDir`, der Zwischenspeicher
     liegt woanders und wird nie übertragen. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
