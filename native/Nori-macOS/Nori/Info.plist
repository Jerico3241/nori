<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>de</string>
    <key>CFBundleDisplayName</key><string>Nori</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <!-- Wie bei iOS: bei GENERATE_INFOPLIST_FILE = NO trägt Xcode den
         Iconverweis nicht selbst nach. Ohne ihn zeigen Dock und Finder das
         graue Standardsymbol statt des Nori-Icons. -->
    <key>CFBundleIconName</key><string>AppIcon</string>
    <key>CFBundleName</key><string>Nori</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <!-- Wird aus der Build-Einstellung TMDB_API_KEY gefüllt. Ist sie nicht
         gesetzt, bleibt der Wert leer und die App nutzt die Cover der
         Quellen; ein Schlüssel lässt sich in den Einstellungen eintragen. -->
    <key>TMDBAPIKey</key><string>$(TMDB_API_KEY)</string>
    <!-- Wird aus der Build-Einstellung GOOGLE_CLIENT_ID gefüllt. Ist sie nicht
         gesetzt, bleibt hier der unaufgelöste Platzhalter stehen, und die
         Einstellungen zeigen „nicht eingerichtet" statt eine Anmeldung
         anzubieten, die sicher scheitert. Eine Client-ID ist kein Geheimnis,
         gehört aber zum Google-Cloud-Projekt des Betreibers und nicht ins
         Repository. Ein Client-Secret gibt es für diesen Fluss nicht; siehe
         docs/google-drive-sync.md. -->
    <key>GoogleClientID</key><string>$(GOOGLE_CLIENT_ID)</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.entertainment</string>
    <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
