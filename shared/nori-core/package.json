{
  "name": "@nori/core",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "description": "Gemeinsamer Nori-Kern für JavaScript-Clients (Modelle, Provider, Parser, Hoster-Resolver, Bibliotheksregeln)",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "linkedom": "^0.18.5",
    "typescript": "^5.6.3"
  }
}
