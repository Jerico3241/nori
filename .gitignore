# Python (Prüfskripte in tools/)
__pycache__/
*.pyc

# OS / IDE
.DS_Store
*.swp
.idea
.vscode
*.iml

# Xcode
native/*/build/
xcuserdata/
DerivedData/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# SwiftPM (Testpaket unter native/)
.build/
.swiftpm/
Package.resolved

# Node / build
node_modules/
.output/
dist/
.nitro/
.tanstack/
*.log

# Secrets / sandbox
.env
.env.*
.grok/

# Google-OAuth, lokal je Plattform. Die Client-IDs und das macOS-Secret
# stehen hier und nirgends sonst; die OAuth-JSON-Dateien liegen ausserhalb
# des Repositorys unter ~/.config/nori/secrets/ und dürfen nie hinein.
native/*/Config/*.local.xcconfig
client_secret*.json
google-*-oauth.json
*oauth*.json
AGENTS.md

# Local data & packaged binaries (Releases, not git)
Nori-Daten/
*.ipa
*.app

# webOS (apps/webos)
*.ipk
apps/webos/dist/
apps/webos/test-shots/
# Messwerte von `test/perf-bench.mjs` — die Zahlen stehen im Changelog.
apps/webos/test-perf/
shared/nori-core/dist/
services/nori-api/dist/
services/nori-api/dist-test/

# Ausgabeordner von `xcodebuild`.
#
# Ohne `-derivedDataPath` legt ein Build ihn neben dem Projekt an, nicht in
# DerivedData. `.build/` weiter oben ist SwiftPM und greift hier nicht.
native/*/build/

# Modul-Zwischenspeicher, den `xcodebuild` neben dem Projekt anlegt.
#
# Er heisst `-Xcc`, liegt *innerhalb* von `.xcodeproj` und wird deshalb von
# keiner der üblichen Xcode-Regeln erfasst. Ein `git add -A` nach einem Build
# nimmt ihn sonst mit: 1600 Dateien, 22 MB, alle generiert.
**/*.xcodeproj/-Xcc/

# Screenshots des Fernbedienungslaufs (npm run test:tv)
apps/webos/shot-*.png

# Windows (apps/windows)
#
# `dist/` fängt die Oberfläche schon weiter oben. Hier der Rest: der
# gebündelte Hauptprozess, die Pakete von electron-builder und was die
# Desktop-Prüfung nebenbei anlegt. `build/` gehört ausdrücklich **nicht**
# dazu — dort liegen die Symbole, und die sind Quelltext.
apps/windows/dist-main/
apps/windows/release/
apps/windows/test-shots/
apps/windows/test-userdata/
